# Ignore Rust build artifacts
target/
# Git ignore file for Rust project

# Build output
/target/

# If you wish to exclude Cargo.lock, uncomment the following line
# /Cargo.lock

# Backup files generated by build scripts
**/*.rs.bk

# Executables and libraries
*.exe
*.dll
*.so
*.dylib

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Editor directories and files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Vim swap files and temporary files
*~
*.swp
*.tmp

# Environment files
.env

# Documentation build
/target/doc/

# Coverage reports
coverage/
*.lcov